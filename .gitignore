# ============================================================
# AnaLog Labs — .gitignore
# Python / PySide6 desktop application
# ============================================================
 
# ============================================================
# ⚠️  CRITICAL — SENSITIVE LOG FILE PROTECTION
# ============================================================
# Real forensic log files must NEVER be committed to this
# repository under any circumstances. These files may contain
# sensitive security investigation data including IP addresses,
# usernames, authentication records, and device identifiers.
#
# The rules below block ALL CSV, XLSX, XLS, and TXT files
# across the ENTIRE repository, including subdirectories.
# The only exception is the sample_logs/ folder which must
# only ever contain synthetic, anonymised test data.
# ============================================================
 
# Block all CSV files everywhere
*.csv
**/*.csv
 
# Block all Excel files everywhere
*.xlsx
**/*.xlsx
*.xls
**/*.xls
*.xlsm
**/*.xlsm
 
# Block all plain text log files everywhere
*.txt
**/*.txt
 
# Block all log extension files
*.log
**/*.log
 
# Block common log export formats
*.tsv
**/*.tsv
*.json
**/*.json
 
# ⚠️ ONLY exception — allow synthetic sample files in sample_logs/
# These must be anonymised/fake data only. See sample_logs/README.md
!sample_logs/
!sample_logs/**
!sample_logs/*.csv
!sample_logs/*.xlsx
!sample_logs/*.txt
!sample_logs/README.md
 
# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-link
.installed.cfg
MANIFEST
 
# ============================================================
# Virtual environments
# ============================================================
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version
 
# ============================================================
# Testing and coverage
# ============================================================
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log
test_output/
test_results/
*.test.log
 
# ============================================================
# PyInstaller — built executables
# ============================================================
*.spec
/dist/
/build/
/release/
 
# ============================================================
# Databases (may contain cached log data)
# ============================================================
*.db
*.sqlite
*.sqlite3
*.duckdb
 
# ============================================================
# Session / state files (may contain investigation data)
# ============================================================
*.session
*.state
/sessions/
/session_data/
 
# ============================================================
# Config files with secrets or local paths
# ============================================================
config.ini
config.yaml
config.json
secrets.yaml
.secrets
local_settings.py
 
# ============================================================
# IDE and editor files
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~
*.iml
*.iws
*.ipr
 
# ============================================================
# OS generated files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
 
# ============================================================
# Temporary and backup files
# ============================================================
*.tmp
*.temp
*.bak
~$*
 
# ============================================================
# Documentation build output
# ============================================================
docs/_build/
docs/build/
site/
 
# ============================================================
# Jupyter Notebooks
# ============================================================
.ipynb_checkpoints
*.ipynb
 
# ============================================================
# Type checkers
# ============================================================
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
